    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "keyboard", "mouse", "vibe", "fx", "feedback"],
  "license": "MIT"
